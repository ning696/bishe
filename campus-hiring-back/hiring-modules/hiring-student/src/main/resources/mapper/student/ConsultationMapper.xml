<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.zc.student.mapper.ConsultationMapper">

    <resultMap id="ConsultationListVOResultMap" type="cn.zc.student.domain.vo.ConsultationListVO">
        <id property="id" column="id"/>
        <result property="enterpriseId" column="enterprise_id"/>
        <result property="enterpriseName" column="enterprise_name"/>
        <result property="jobId" column="job_id"/>
        <result property="jobName" column="job_name"/>
        <result property="consultationType" column="consultation_type"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
        <result property="replyContent" column="reply_content"/>
        <result property="replyTime" column="reply_time"/>
        <result property="status" column="status"/>
        <result property="statusName" column="status_name"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <select id="selectConsultationList" resultMap="ConsultationListVOResultMap">
        SELECT
            c.id,
            c.enterprise_id,
            e.enterprise_name,
            c.job_id,
            j.job_name,
            c.consultation_type,
            c.title,
            c.content,
            c.reply_content,
            c.reply_time,
            c.status,
            CASE c.status
                WHEN 0 THEN '待回复'
                WHEN 1 THEN '已回复'
                WHEN 2 THEN '已关闭'
                ELSE '未知'
            END AS status_name,
            c.create_time
        FROM consultation c
        LEFT JOIN enterprise e ON c.enterprise_id = e.id
        LEFT JOIN job j ON c.job_id = j.id
        WHERE c.student_id = #{studentId}
        ORDER BY c.create_time DESC
    </select>

</mapper>

