<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.zc.enterprise.mapper.EnterpriseMapper">

    <resultMap id="EnterpriseDetailVOResultMap" type="cn.zc.enterprise.domain.vo.EnterpriseDetailVO">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="enterpriseName" column="enterprise_name"/>
        <result property="legalPerson" column="legal_person"/>
        <result property="phone" column="phone"/>
        <result property="email" column="email"/>
        <result property="logo" column="logo"/>
        <result property="address" column="address"/>
        <result property="industry" column="industry"/>
        <result property="scale" column="scale"/>
        <result property="description" column="description"/>
        <result property="website" column="website"/>
        <result property="certificationStatus" column="certification_status"/>
        <result property="certificationStatusName" column="certification_status_name"/>
        <result property="certificationFile" column="certification_file"/>
        <result property="status" column="status"/>
        <result property="statusName" column="status_name"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <select id="selectEnterpriseDetail" resultMap="EnterpriseDetailVOResultMap">
        SELECT
            e.id,
            e.username,
            e.enterprise_name,
            e.legal_person,
            e.phone,
            e.email,
            e.logo,
            e.address,
            e.industry,
            e.scale,
            e.description,
            e.website,
            e.certification_status,
            CASE e.certification_status
                WHEN 0 THEN '未认证'
                WHEN 1 THEN '已认证'
                WHEN 2 THEN '认证中'
                WHEN 3 THEN '认证失败'
                ELSE '未知'
            END AS certification_status_name,
            e.certification_file,
            e.status,
            CASE e.status
                WHEN 0 THEN '已拉黑'
                WHEN 1 THEN '正常'
                WHEN 2 THEN '已禁用'
                WHEN 3 THEN '待审核'
                ELSE '未知'
            END AS status_name,
            e.create_time
        FROM enterprise e
        WHERE e.id = #{enterpriseId}
    </select>

</mapper>

