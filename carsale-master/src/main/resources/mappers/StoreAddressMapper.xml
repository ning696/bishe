<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gxyan.dao.StoreAddressMapper">

    <resultMap type="com.gxyan.domain.StoreAddress" id="StoreAddressResult">
        <result property="id"    column="id"    />
        <result property="provinceCode"    column="province_code"    />
        <result property="cityCode"    column="city_code"    />
        <result property="districtCode"    column="district_code"    />
        <result property="location"    column="location"    />
        <result property="phoneNumber"    column="phone_number"    />
        <result property="createdAt"    column="created_at"    />
        <result property="updatedAt"    column="updated_at"    />
    </resultMap>

    <sql id="selectStoreAddressVo">
        select id, province_code, city_code, district_code, location, phone_number, created_at, updated_at from store_address
    </sql>

    <select id="selectStoreAddressList" parameterType="com.gxyan.domain.StoreAddress" resultMap="StoreAddressResult">
        <include refid="selectStoreAddressVo"/>
        <where>
            <if test="provinceCode != null  and provinceCode != ''"> and province_code = #{provinceCode}</if>
            <if test="cityCode != null  and cityCode != ''"> and city_code = #{cityCode}</if>
            <if test="districtCode != null  and districtCode != ''"> and district_code = #{districtCode}</if>
            <if test="location != null  and location != ''"> and location = #{location}</if>
            <if test="phoneNumber != null  and phoneNumber != ''"> and phone_number = #{phoneNumber}</if>
        </where>
    </select>

    <select id="selectStoreAddressById" parameterType="java.lang.Long" resultMap="StoreAddressResult">
        <include refid="selectStoreAddressVo"/>
        where id = #{id}
    </select>

    <insert id="insertStoreAddress" parameterType="com.gxyan.domain.StoreAddress" useGeneratedKeys="true" keyProperty="id">
        insert into store_address
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="provinceCode != null and provinceCode != ''">province_code,</if>
            <if test="cityCode != null and cityCode != ''">city_code,</if>
            <if test="districtCode != null and districtCode != ''">district_code,</if>
            <if test="location != null and location != ''">location,</if>
            <if test="phoneNumber != null and phoneNumber != ''">phone_number,</if>
            <if test="createdAt != null">created_at,</if>
            <if test="updatedAt != null">updated_at,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="provinceCode != null and provinceCode != ''">#{provinceCode},</if>
            <if test="cityCode != null and cityCode != ''">#{cityCode},</if>
            <if test="districtCode != null and districtCode != ''">#{districtCode},</if>
            <if test="location != null and location != ''">#{location},</if>
            <if test="phoneNumber != null and phoneNumber != ''">#{phoneNumber},</if>
            <if test="createdAt != null">#{createdAt},</if>
            <if test="updatedAt != null">#{updatedAt},</if>
         </trim>
    </insert>

    <update id="updateStoreAddress" parameterType="com.gxyan.domain.StoreAddress">
        update store_address
        <trim prefix="SET" suffixOverrides=",">
            <if test="provinceCode != null and provinceCode != ''">province_code = #{provinceCode},</if>
            <if test="cityCode != null and cityCode != ''">city_code = #{cityCode},</if>
            <if test="districtCode != null and districtCode != ''">district_code = #{districtCode},</if>
            <if test="location != null and location != ''">location = #{location},</if>
            <if test="phoneNumber != null and phoneNumber != ''">phone_number = #{phoneNumber},</if>
            <if test="createdAt != null">created_at = #{createdAt},</if>
            <if test="updatedAt != null">updated_at = #{updatedAt},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteStoreAddressById" parameterType="java.lang.Long">
        delete from store_address where id = #{id}
    </delete>

    <delete id="deleteStoreAddressByIds" parameterType="java.lang.Long">
        delete from store_address where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
